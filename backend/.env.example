DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/launchkit
SECRET_KEY=change-me-in-production
DEBUG=true
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
# Number of trusted reverse proxies in front of the backend (the bundled nginx
# frontend counts as 1). Rate limiting keys requests by client IP; leaving this
# at 0 in a proxied deployment means every client shares one rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# Optional OIDC login (Authentik, Pocket ID, or standard OIDC providers)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_REGISTER=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false only with OIDC_ENABLED=true, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL configured
LOCAL_AUTH_ENABLED=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
OIDC_WORKSPACE_ROLE_MAP=

# File uploads (stored under STORAGE_LOCAL_PATH)
STORAGE_LOCAL_PATH=./data/files
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,heic,pdf

# "owner/repo" on GitHub to check for new releases (empty disables the check)
UPDATE_CHECK_REPO=
