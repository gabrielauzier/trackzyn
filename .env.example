# Required
SECRET_KEY=change-me-in-production

# Backend stack: python (FastAPI + Celery) or node (Fastify + BullMQ). Same API, same database.
# BACKEND_STACK=python

# Public URL the app is served from. Used for CORS, OIDC callbacks and passkeys.
# FRONTEND_URL=https://app.example.com

# Registration (optional) — admins can also toggle this in Admin Settings.
# REGISTRATION_ENABLED=true

# File uploads (optional)
# STORAGE_MAX_FILE_SIZE_MB=10
# STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,heic,pdf

# Update banner (optional) — "owner/repo" on GitHub whose latest release is
# compared to the running version. Leave empty to disable the check.
# UPDATE_CHECK_REPO=acme/trackzyn

# OIDC login (optional) — Authentik, Pocket ID, or any standard OIDC provider
## Redirect/callback URL to register in the provider:
##   http://localhost:${FRONTEND_PORT:-3000}/api/auth/oidc/callback
# OIDC_ENABLED=true
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=trackzyn
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_REGISTER=true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Optional: require OIDC-only login; requires OIDC_ENABLED, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL
# Disables local login, registration, password reset/change, and new passkey ceremonies
# LOCAL_AUTH_ENABLED=false
# Link an OIDC login to an existing account with the same email:
#   disabled (default) never links, verified_email links only when the provider
#   sends email_verified=true, email links on a matching email alone.
# OIDC_EXISTING_USER_LINK_MODE=disabled
# Optional: sync admin/workspace roles from OIDC roles/groups
# OIDC_SYNC_ROLES=true
# OIDC_ROLES_CLAIM=groups
# OIDC_ADMIN_ROLES=trackzyn-admins
# OIDC_WORKSPACE_ROLE_MAP={"trackzyn-owners":"owner","trackzyn-editors":"editor","trackzyn-viewers":"viewer"}

# Passkeys (optional) — nothing to set for the common cases.
## Passkeys follow the address you open the app on, so they work out of the box on
## http://localhost:3000 and on any HTTPS domain behind a reverse proxy.
## WebAuthn never allows an IP address or plain HTTP (except on localhost).
## Optional: pin passkeys to a single domain. Leave unset to follow the browser.
# WEBAUTHN_RP_ID=app.example.com
## Optional: the name shown in the browser's passkey prompt.
# WEBAUTHN_RP_NAME=trackzyn

# Timezone (optional). Calendar dates follow the timezone saved in Admin
## Settings; without one, this variable, then the host timezone, then UTC.
# TZ=America/Sao_Paulo

# Host ports (optional) — change these to avoid conflicts with other services
# FRONTEND_PORT=3000
# BACKEND_PORT=8000

# Production images (docker-compose.prod.yml)
# IMAGE_PREFIX=ghcr.io/acme/trackzyn
# APP_VERSION=latest
