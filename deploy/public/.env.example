# Modelo de ambiente de PRODUÇÃO para o launchkit atrás de um Cloudflare Tunnel.
# Copie para `deploy/public/.env`, preencha e proteja: `chmod 600 deploy/public/.env`.
# O `.env` real NUNCA deve ser commitado (já coberto pelo .gitignore do repositório).
#
# Uso:
#   docker compose -p launchkit-prod --env-file deploy/public/.env -f docker-compose.prod.yml up -d

# Gere cada valor com:  openssl rand -hex 32
# ATENÇÃO: o SECRET_KEY assina as sessões e os tokens de login. Guarde uma cópia no gerenciador de senhas;
# se ele mudar, todos os logins ativos caem.
SECRET_KEY=

# URL pública EXATA (esquema + host, sem barra final). Controla CORS, callbacks OAuth e passkeys.
FRONTEND_URL=https://app.example.com

# Publicar só no loopback: quem expõe o serviço é o túnel, não a rede local.
# (Use portas diferentes das do ambiente de desenvolvimento, se ele rodar na mesma máquina.)
FRONTEND_PORT=127.0.0.1:3100
BACKEND_PORT=127.0.0.1:8100

# Quantos proxies existem entre o cliente e o backend, para o rate limit ler o IP real do cliente.
# Cloudflare -> cloudflared -> nginx do frontend = 2. Valor maior que o real permite forjar o IP;
# menor faz todos compartilharem o mesmo limite. Valide como descrito no README.
TRUSTED_PROXY_HOPS=2

# Imagens do Docker: prefixo no registry e versão (lidos pelo docker-compose.prod.yml).
# Em PRODUÇÃO FIXE a versão, para que um `pull` não traga uma release nova sem você ter lido as notas e feito
# backup. Ver RELEASING.md.
IMAGE_PREFIX=ghcr.io/your-org/launchkit
APP_VERSION=latest
