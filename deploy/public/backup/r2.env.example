# Modelo para ~/.config/launchkit-backup/r2.env  (copie, preencha e rode: chmod 600 ~/.config/launchkit-backup/r2.env)
# NUNCA commitar o arquivo preenchido. Estes valores vêm do painel da Cloudflare (R2).

# ID da conta: painel Cloudflare -> R2 -> "Account ID" (coluna da direita)
R2_ACCOUNT_ID=
# Credenciais de um API token do R2 com permissão "Object Read & Write", restrito ao bucket abaixo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket criado no R2 (ex.: meu-bucket-de-backups)
R2_BUCKET=
# Pasta dentro do bucket (opcional; padrão: launchkit)
R2_PREFIX=launchkit
# Quantos dias manter no R2 (opcional; padrão: 90)
KEEP_REMOTE_DAYS=90
